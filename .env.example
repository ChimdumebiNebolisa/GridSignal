# GridSignal Texas - Environment Variables
# Copy this file to .env.local and fill in your API keys.
# Never commit .env.local to source control.

# Optional: NREL Developer API Key for live PVWatts solar fetches.
# Without it, the app uses bundled cached/estimated solar data.
# https://developer.nrel.gov/signup/
NREL_API_KEY=

# Optional: EIA API Key for live ERCO balancing-authority grid strain.
# Without it, the app uses a neutral statewide fallback.
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional: Census API Key for population cache refresh scripts.
# Runtime uses bundled static Census population by default.
CENSUS_API_KEY=

# Reserved for future ERCOT integration. Not used by the current app.
ERCOT_API_KEY=
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=

# Public app display name only. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=GridSignal Texas
